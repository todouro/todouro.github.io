<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>todouro</title>

<link rel="preconnect" href="https://fonts.bunny.net">
<link href="https://fonts.bunny.net/css?family=jetbrains-mono:400,500,600,700|outfit:400,500,600,700" rel="stylesheet">
<script src="https://unpkg.com/css-doodle@0.39.7/css-doodle.min.js"></script>

<style>
*, *::before, *::after {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

:root {
  --bg: #05050a;
  --card: rgba(12, 12, 20, 0.88);
  --card2: rgba(18, 18, 30, 0.9);
  --border: rgba(255, 255, 255, 0.08);
  --border2: rgba(255, 255, 255, 0.15);
  --text: #e8edf7;
  --dim: #9aa8bd;
  --faint: #56657b;
  --peach: #b9c7ff;
  --peach2: rgba(185, 199, 255, 0.16);
  --pink: #a78bfa;
  --green: #4ade80;
  --spring: cubic-bezier(0.16, 1.2, 0.32, 1);
  --mono: "JetBrains Mono", monospace;
  --body: "Outfit", sans-serif;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 110px;
}

body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: var(--mono);
  -webkit-font-smoothing: antialiased;
  min-height: 100vh;
  overflow-x: hidden;
}

a {
  color: inherit;
}

img {
  display: block;
}

.wrap {
  width: min(100%, 840px);
  margin: 0 auto;
  padding: 44px 28px 92px;
}

nav {
  position: sticky;
  top: 18px;
  z-index: 20;
  width: fit-content;
  display: flex;
  gap: 8px;
  margin-bottom: 54px;
  padding: 8px;
  border: 1px solid rgba(255, 255, 255, 0.075);
  border-radius: 16px;
  background: rgba(8, 8, 15, 0.72);
  backdrop-filter: blur(16px);
}

nav a {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.13em;
  text-transform: uppercase;
  color: var(--faint);
  text-decoration: none;
  padding: 8px 10px 10px;
  border-radius: 10px;
  transition: color 0.18s ease, background 0.18s ease, box-shadow 0.18s ease;
}

nav a::after {
  content: "";
  position: absolute;
  left: 12px;
  right: 12px;
  bottom: 4px;
  height: 2px;
  border-radius: 999px;
  background: linear-gradient(90deg, var(--pink), var(--peach));
  box-shadow: 0 0 12px rgba(255, 102, 170, 0.44);
  opacity: 0;
  transform: scaleX(0.35);
  transform-origin: center;
  transition: opacity 0.18s ease, transform 0.18s ease;
}

nav a:hover,
nav a.is-active {
  color: var(--text);
  background: rgba(255, 255, 255, 0.045);
}

nav a.is-active {
  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.045);
}

nav a.is-active::after {
  opacity: 1;
  transform: scaleX(1);
}

.section {
  margin-bottom: 58px;
}

#about {
  padding: 12px 0 4px;
}

.name-stage {
  position: relative;
  width: min(100%, 740px);
  height: clamp(130px, 19vw, 175px);
  margin-bottom: 18px;
  overflow: visible;
}

.name-doodle {
  position: absolute;
  inset: 0;
  z-index: 2;
  width: 100%;
  height: 100%;
  display: block;
  overflow: visible;
}

.name-fallback {
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
}

.name-fallback span {
  position: absolute;
  left: 50%;
  top: 50%;
  font-family: var(--mono);
  font-size: clamp(42px, 9vw, 90px);
  line-height: 0;
  font-weight: 800;
  letter-spacing: -0.08em;
  white-space: nowrap;
  -webkit-text-stroke: 0.25vw #05050a;
  text-stroke: 0.25vw #05050a;
  transform-origin: center;
}

.name-fallback span:nth-child(1) {
  color: #fff8ec;
  z-index: 5;
  transform: translate(-50%, -50%) rotate(-1.8deg) scale(1);
}

.name-fallback span:nth-child(2) {
  color: #feb944;
  z-index: 4;
  transform: translate(-49%, -46%) rotate(-0.8deg) scale(0.95);
}

.name-fallback span:nth-child(3) {
  color: #fe6842;
  z-index: 3;
  transform: translate(-48%, -42%) rotate(0.6deg) scale(0.9);
}

.name-fallback span:nth-child(4) {
  color: #df5584;
  z-index: 2;
  transform: translate(-47%, -38%) rotate(1.5deg) scale(0.85);
}

.name-fallback span:nth-child(5) {
  color: #5a5ca8;
  z-index: 1;
  transform: translate(-46%, -34%) rotate(2.4deg) scale(0.8);
}

.intro-meta {
  display: flex;
  flex-direction: column;
  gap: 7px;
  margin-bottom: 22px;
}

.intro-meta p {
  font-size: 14px;
  color: var(--dim);
}

.intro-meta p::before {
  content: "-> ";
  color: var(--faint);
}

.intro-bio {
  font-family: var(--body);
  font-size: 16px;
  line-height: 1.72;
  color: #d3dbea;
  max-width: 650px;
  letter-spacing: 0.01em;
}

.osu-card {
  display: flex;
  align-items: flex-start;
  gap: 18px;
  margin-top: 28px;
  padding: 18px;
  border: 1px solid var(--border);
  border-radius: 18px;
  background: var(--card);
  text-decoration: none;
  color: inherit;
  overflow: hidden;
  transition: border-color 0.18s ease, background 0.18s ease;
}

.osu-card:hover {
  border-color: rgba(255, 102, 170, 0.28);
  background: var(--card2);
}

.osu-logo {
  width: 72px;
  height: 72px;
  border-radius: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ff66aa;
  flex-shrink: 0;
  overflow: hidden;
  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.22);
}

.osu-logo img {
  width: 58px;
  height: 58px;
  object-fit: contain;
}

.osu-info {
  min-width: 0;
  flex: 1;
}

.osu-status {
  display: flex;
  align-items: center;
  gap: 7px;
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  color: #ff8fc4;
  margin-bottom: 7px;
}

.dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--pink);
}

.osu-name {
  font-size: 18px;
  font-weight: 800;
  color: var(--text);
}

.osu-note {
  margin-top: 5px;
  font-size: 12px;
  color: var(--dim);
  line-height: 1.55;
}

.osu-mini-stats {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 9px;
  margin-top: 14px;
}

.osu-mini-stat {
  border: 1px solid rgba(255, 255, 255, 0.075);
  border-radius: 10px;
  background: rgba(255, 255, 255, 0.028);
  padding: 9px 10px;
  min-width: 0;
}

.osu-mini-stat span {
  display: block;
  font-size: 8px;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--faint);
}

.osu-mini-stat strong {
  display: block;
  font-size: 12px;
  margin-top: 4px;
  color: var(--dim);
  font-weight: 700;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.sec-label {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--faint);
  margin-bottom: 18px;
  padding-bottom: 10px;
}

.sec-label::after {
  content: "";
  height: 1px;
  flex: 1;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0.12), transparent);
}

.projects {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.project {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding: 18px;
  border: 1px solid var(--border);
  border-radius: 18px;
  background: var(--card);
  overflow: hidden;
  transition: transform 0.18s ease, border-color 0.18s ease, background 0.18s ease, box-shadow 0.18s ease;
}

.project:hover {
  transform: translateY(-1px);
  border-color: rgba(255, 203, 164, 0.18);
  background: var(--card2);
}

.project.is-live {
  border-color: rgba(74, 222, 128, 0.18);
  background:
    radial-gradient(circle at 100% 0%, rgba(74, 222, 128, 0.1), transparent 34%),
    radial-gradient(circle at 0% 100%, rgba(255, 102, 170, 0.08), transparent 34%),
    var(--card);
}

.project.is-live:hover {
  border-color: rgba(74, 222, 128, 0.34);
  box-shadow: 0 18px 46px rgba(0, 0, 0, 0.22), 0 0 26px rgba(74, 222, 128, 0.06);
}

.project-top {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 14px;
}

.project-name {
  font-size: 17px;
  font-weight: 800;
  color: var(--text);
  text-decoration: none;
}

.project-name:hover {
  color: var(--peach);
}

.project-desc {
  font-family: var(--body);
  font-size: 14px;
  color: var(--dim);
  line-height: 1.55;
}

.project-link {
  font-size: 11px;
  color: var(--faint);
  letter-spacing: 0.06em;
}

.project-link::before {
  content: "-> ";
}

.project-meta-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
  margin-top: 2px;
}

.project-site-pill {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  width: fit-content;
  border-radius: 999px;
  padding: 6px 10px;
  font-size: 10px;
  font-weight: 800;
  line-height: 1;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  text-decoration: none;
}


.project-site-pill {
  color: var(--peach);
  border: 1px solid rgba(255, 203, 164, 0.24);
  background: rgba(255, 203, 164, 0.09);
  transition: color 0.18s ease, border-color 0.18s ease, background 0.18s ease;
}

.project-site-pill:hover {
  color: var(--text);
  border-color: rgba(255, 203, 164, 0.42);
  background: rgba(255, 203, 164, 0.14);
}

.stack-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.stack-item {
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 10px 14px;
  border-radius: 12px;
  border: 1px solid var(--border);
  background: var(--card);
  font-size: 13px;
  color: var(--dim);
  cursor: default;
  transition: border-color 0.18s ease, color 0.18s ease, background 0.18s ease;
}

.stack-item:hover {
  border-color: var(--border2);
  color: var(--text);
  background: rgba(255, 255, 255, 0.04);
}

.logo-img {
  width: 19px;
  height: 19px;
  flex-shrink: 0;
  border-radius: 4px;
}

.games-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
}

.game-item {
  min-height: 86px;
  display: flex;
  align-items: center;
  gap: 15px;
  padding: 16px;
  border: 1px solid var(--border);
  border-radius: 18px;
  background: var(--card);
  cursor: default;
  overflow: hidden;
  transition: border-color 0.18s ease, background 0.18s ease;
}

.game-item:hover {
  border-color: var(--border2);
  background: var(--card2);
}

.game-icon,
.game-logo-wide {
  height: 52px;
  border-radius: 14px;
  overflow: hidden;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.07);
}

.game-icon {
  width: 52px;
}

.game-logo-wide {
  width: 74px;
  padding: 10px;
}

.game-icon img {
  width: 34px;
  height: 34px;
  object-fit: contain;
}

.game-logo-wide img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
}

.game-logo-fallback {
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.08em;
  color: var(--text);
  text-align: center;
  line-height: 1.15;
}

.game-info {
  min-width: 0;
}

.game-name {
  font-size: 15px;
  font-weight: 800;
  color: var(--text);
}

.game-sub {
  font-size: 11px;
  color: var(--faint);
  letter-spacing: 0.06em;
  margin-top: 3px;
}

.anime-list {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.currently-watching-card,
.anime-item {
  --anime-banner: linear-gradient(135deg, rgba(255, 102, 170, 0.15), rgba(255, 203, 164, 0.08));
  --anime-accent: var(--peach);
  position: relative;
  isolation: isolate;
  overflow: hidden;
  color: inherit;
  text-decoration: none;
}

.currently-watching-card {
  min-height: 96px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 16px;
  padding: 16px 18px;
  border: 1px solid rgba(255, 203, 164, 0.18);
  border-radius: 20px;
  background: rgba(12, 12, 20, 0.76);
  transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
}

.currently-watching-card::before,
.anime-item::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -2;
  background-image: var(--anime-banner);
  background-size: cover;
  background-position: center;
  opacity: 0.42;
  transform: scale(1.04);
  filter: saturate(1.08) contrast(1.04);
  transition: opacity 0.22s ease, transform 0.22s ease, filter 0.22s ease;
}

.currently-watching-card::after,
.anime-item::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -1;
  background:
    radial-gradient(circle at 18% 50%, rgba(255, 255, 255, 0.06), transparent 34%),
    linear-gradient(90deg, rgba(5, 5, 10, 0.94) 0%, rgba(5, 5, 10, 0.82) 42%, rgba(5, 5, 10, 0.56) 100%),
    linear-gradient(180deg, rgba(5, 5, 10, 0.2), rgba(5, 5, 10, 0.86));
}

.currently-watching-card:hover,
.anime-item:hover {
  transform: translateY(-1px);
  border-color: color-mix(in srgb, var(--anime-accent) 42%, rgba(255, 255, 255, 0.14));
  background: var(--card2);
  box-shadow: 0 12px 38px rgba(0, 0, 0, 0.28), 0 0 20px color-mix(in srgb, var(--anime-accent) 12%, transparent);
}

.currently-watching-card:hover::before,
.anime-item:hover::before {
  opacity: 0.58;
  transform: scale(1.045);
  filter: brightness(1.06) saturate(1.12) contrast(1.04);
}

.current-watch-left {
  display: flex;
  align-items: center;
  gap: 14px;
  min-width: 0;
}

.current-watch-thumb {
  width: 50px;
  height: 68px;
  border-radius: 12px;
  overflow: hidden;
  flex-shrink: 0;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.12);
  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.36);
}

.current-watch-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.current-watch-kicker {
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--peach);
}

.current-watch-title {
  font-size: 17px;
  font-weight: 850;
  color: var(--text);
  text-shadow: 0 2px 18px rgba(0, 0, 0, 0.45);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.current-watch-sub {
  font-size: 11px;
  color: rgba(232, 237, 247, 0.68);
}

.current-watch-pill {
  flex-shrink: 0;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.13em;
  color: var(--peach);
  border: 1px solid rgba(255, 203, 164, 0.34);
  background: rgba(255, 203, 164, 0.12);
  padding: 8px 10px;
  border-radius: 999px;
}

.anime-item {
  display: flex;
  align-items: center;
  gap: 18px;
  min-height: 136px;
  padding: 18px;
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 20px;
  background: var(--card);
  transition: transform 0.18s ease, border-color 0.18s ease, background 0.18s ease, box-shadow 0.18s ease;
}

.anime-thumb {
  width: 76px;
  height: 106px;
  border-radius: 14px;
  overflow: hidden;
  flex-shrink: 0;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12px 36px rgba(0, 0, 0, 0.38);
  transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
}

.anime-item:hover .anime-thumb,
.currently-watching-card:hover .current-watch-thumb {
  transform: translateY(-2px) scale(1.035);
  border-color: color-mix(in srgb, var(--anime-accent) 42%, rgba(255, 255, 255, 0.16));
  box-shadow: 0 14px 34px rgba(0, 0, 0, 0.38), 0 0 16px color-mix(in srgb, var(--anime-accent) 14%, transparent);
}

.anime-logo {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.current-watch-thumb .anime-logo {
  border-radius: inherit;
}

.anime-thumb-fallback {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10px;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.12em;
  color: var(--text);
  text-align: center;
  line-height: 1.25;
  background: linear-gradient(145deg, rgba(255, 102, 170, 0.2), rgba(255, 203, 164, 0.14));
}

.anime-info {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.anime-title {
  font-size: 16px;
  font-weight: 800;
  color: var(--text);
  text-shadow: 0 2px 18px rgba(0, 0, 0, 0.45);
}

.anime-title-jp {
  font-size: 11px;
  color: rgba(232, 237, 247, 0.58);
}

.anime-badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: 10px;
  letter-spacing: 0.11em;
  text-transform: uppercase;
  color: var(--peach);
  border: 1px solid color-mix(in srgb, var(--anime-accent) 44%, rgba(255, 255, 255, 0.1));
  background: color-mix(in srgb, var(--anime-accent) 15%, rgba(8, 8, 15, 0.72));
  padding: 4px 9px;
  border-radius: 8px;
  width: fit-content;
  margin-top: 4px;
}

.anime-badge.is-complete {
  color: var(--green);
  border-color: rgba(74, 222, 128, 0.32);
  background: rgba(74, 222, 128, 0.11);
}

.anime-badge.episode {
  text-transform: none;
}

.socials {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.socials a {
  font-size: 13px;
  color: var(--dim);
  text-decoration: none;
  padding: 9px 13px;
  border: 1px solid var(--border);
  border-radius: 12px;
  background: var(--card);
  transition: color 0.18s ease, border-color 0.18s ease, background 0.18s ease;
}

.socials a:hover {
  color: var(--text);
  border-color: var(--border2);
  background: rgba(255, 255, 255, 0.04);
}

footer {
  margin-top: 52px;
  padding-top: 22px;
  border-top: 1px solid var(--border);
  font-size: 11px;
  color: var(--faint);
  letter-spacing: 0.06em;
}

.fade-in {
  opacity: 0;
  transform: translateY(10px);
  animation: fadeUp 0.45s ease both;
}

@keyframes fadeUp {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.fade-in:nth-child(1) { animation-delay: 0.04s; }
.fade-in:nth-child(2) { animation-delay: 0.11s; }
.fade-in:nth-child(3) { animation-delay: 0.18s; }
.fade-in:nth-child(4) { animation-delay: 0.25s; }
.fade-in:nth-child(5) { animation-delay: 0.32s; }
.fade-in:nth-child(6) { animation-delay: 0.39s; }
.fade-in:nth-child(7) { animation-delay: 0.46s; }


/* subtle bouncy interaction pass */
.project,
.game-item,
.currently-watching-card,
.anime-item,
.anime-thumb,
.current-watch-thumb,
.socials a,
.project-site-pill,
nav a {
  will-change: transform;
}

.project,
.game-item,
.currently-watching-card,
.anime-item {
  transition-timing-function: var(--spring);
}

@keyframes bounceCardSoft {
  0% {
    transform: translateY(0) scale(1);
  }
  45% {
    transform: translateY(-2px) scale(1.005);
  }
  72% {
    transform: translateY(-0.5px) scale(1.002);
  }
  100% {
    transform: translateY(-1px) scale(1.003);
  }
}

@keyframes bounceButtonSoft {
  0% {
    transform: translateY(0) scale(1);
  }
  55% {
    transform: translateY(-1.5px) scale(1.01);
  }
  100% {
    transform: translateY(-0.5px) scale(1.004);
  }
}

@keyframes coverPopSoft {
  0% {
    transform: translateY(0) scale(1);
  }
  55% {
    transform: translateY(-3px) scale(1.045);
  }
  100% {
    transform: translateY(-2px) scale(1.035);
  }
}

.project:hover,
.game-item:hover,
.currently-watching-card:hover,
.anime-item:hover {
  animation: bounceCardSoft 0.36s var(--spring) both;
}

.socials a:hover,
.project-site-pill:hover,
nav a:hover {
  animation: bounceButtonSoft 0.28s var(--spring) both;
}

.anime-item:hover .anime-thumb,
.currently-watching-card:hover .current-watch-thumb {
  animation: coverPopSoft 0.34s var(--spring) both;
}

.project:active,
.game-item:active,
.currently-watching-card:active,
.anime-item:active,
.socials a:active,
.project-site-pill:active,
nav a:active {
  transform: translateY(0) scale(0.992);
}


@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
  }
}

@media (max-width: 640px) {
  .wrap {
    padding: 30px 16px 70px;
  }

  nav {
    top: 10px;
    width: 100%;
    gap: 6px;
    padding: 7px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    margin-bottom: 42px;
  }

  nav::-webkit-scrollbar {
    display: none;
  }

  nav a {
    flex: 0 0 auto;
    scroll-snap-align: start;
    font-size: 10px;
    letter-spacing: 0.11em;
    white-space: nowrap;
    padding: 8px 9px 10px;
  }

  nav a::after {
    left: 10px;
    right: 10px;
    bottom: 3px;
  }

  .section {
    margin-bottom: 48px;
  }

  .project {
    padding: 16px;
    border-radius: 16px;
  }

  .project-top {
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  .project-site-pill {
    padding: 6px 9px;
    font-size: 9px;
    letter-spacing: 0.1em;
  }

  .project-desc {
    font-size: 13.5px;
  }

  .games-grid {
    grid-template-columns: 1fr;
  }

  .intro-bio {
    font-size: 15px;
  }

  .name-stage {
    height: 120px;
  }

  .osu-card {
    align-items: flex-start;
  }

  .currently-watching-card {
    min-height: 132px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 18px;
  }

  .currently-watching-card::after {
    background:
      linear-gradient(180deg, rgba(5, 5, 10, 0.46) 0%, rgba(5, 5, 10, 0.86) 72%, rgba(5, 5, 10, 0.94) 100%),
      radial-gradient(circle at 50% 20%, rgba(255, 255, 255, 0.08), transparent 42%);
  }

  .current-watch-left {
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .current-watch-title {
    white-space: normal;
  }

  .anime-item {
    min-height: 260px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 22px 18px;
    gap: 13px;
  }

  .anime-item::before {
    opacity: 0.56;
    transform: scale(1.03);
  }

  .anime-item::after {
    background:
      linear-gradient(180deg, rgba(5, 5, 10, 0.38) 0%, rgba(5, 5, 10, 0.74) 50%, rgba(5, 5, 10, 0.94) 100%),
      radial-gradient(circle at 50% 18%, rgba(255, 255, 255, 0.08), transparent 42%);
  }

  .anime-thumb {
    width: 96px;
    height: 132px;
    border-radius: 16px;
  }

  .anime-info {
    align-items: center;
  }

  .anime-badge {
    margin-left: auto;
    margin-right: auto;
  }

  .osu-mini-stats {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 7px;
  }
}


/* Todouro profile additions */
.profile-tags,
.connection-list {
  display: flex;
  flex-wrap: wrap;
  gap: 9px;
}

.profile-tags {
  margin-top: 20px;
}

.profile-tag,
.connection-pill {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  border: 1px solid var(--border);
  border-radius: 999px;
  background: var(--card);
  color: var(--dim);
  padding: 8px 11px;
  font-size: 11px;
  text-decoration: none;
  transition: transform 0.18s var(--spring), color 0.18s ease, border-color 0.18s ease, background 0.18s ease;
}

.profile-tag:hover,
.connection-pill:hover {
  transform: translateY(-1px);
  color: var(--text);
  border-color: var(--border2);
  background: rgba(255, 255, 255, 0.045);
}

.favorite-card {
  --favorite-image: url("assets/games/zelda-botw.jpg");
  position: relative;
  isolation: isolate;
  min-height: 210px;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
  padding: 24px;
  border: 1px solid rgba(185, 199, 255, 0.22);
  border-radius: 22px;
  background: var(--card);
  text-decoration: none;
  color: inherit;
  transition: transform 0.22s var(--spring), border-color 0.18s ease, box-shadow 0.18s ease;
}

.favorite-card::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -2;
  background-image: var(--favorite-image);
  background-size: cover;
  background-position: center 35%;
  filter: saturate(1.08) contrast(1.05);
  transform: scale(1.04);
  transition: transform 0.3s ease, filter 0.3s ease;
}

.favorite-card::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -1;
  background:
    linear-gradient(90deg, rgba(5, 5, 10, 0.97) 0%, rgba(5, 5, 10, 0.78) 50%, rgba(5, 5, 10, 0.22) 100%),
    linear-gradient(180deg, rgba(5, 5, 10, 0.08), rgba(5, 5, 10, 0.86));
}

.favorite-card:hover {
  transform: translateY(-2px);
  border-color: rgba(185, 199, 255, 0.45);
  box-shadow: 0 20px 54px rgba(0, 0, 0, 0.35), 0 0 26px rgba(167, 139, 250, 0.09);
}

.favorite-card:hover::before {
  transform: scale(1.075);
  filter: brightness(1.06) saturate(1.12) contrast(1.04);
}

.favorite-copy {
  max-width: 520px;
}

.favorite-kicker {
  display: block;
  margin-bottom: 8px;
  color: #c4b5fd;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.19em;
  text-transform: uppercase;
}

.favorite-title {
  display: block;
  font-family: var(--body);
  color: #fff;
  font-size: clamp(24px, 5vw, 38px);
  line-height: 1.04;
  letter-spacing: -0.035em;
}

.favorite-quote {
  display: block;
  max-width: 410px;
  margin-top: 11px;
  color: rgba(232, 237, 247, 0.78);
  font-family: var(--body);
  font-size: 14px;
  line-height: 1.5;
}

.game-cover {
  width: 62px;
  height: 82px;
  flex: 0 0 auto;
  border-radius: 12px;
  object-fit: cover;
  border: 1px solid rgba(255,255,255,0.11);
  box-shadow: 0 10px 26px rgba(0,0,0,0.35);
  transition: transform 0.22s var(--spring);
}

.game-item:hover .game-cover {
  transform: translateY(-2px) scale(1.025);
}

.game-item {
  min-height: 116px;
}

.anime-rank {
  flex: 0 0 34px;
  color: rgba(232, 237, 247, 0.24);
  font-size: 13px;
  font-weight: 800;
  letter-spacing: 0.08em;
}

.link-note {
  margin-top: 13px;
  color: var(--faint);
  font-size: 11px;
  line-height: 1.6;
}

@media (max-width: 640px) {
  .favorite-card {
    min-height: 270px;
    padding: 20px;
    align-items: flex-end;
  }

  .favorite-card::after {
    background:
      linear-gradient(180deg, rgba(5, 5, 10, 0.16) 0%, rgba(5, 5, 10, 0.78) 58%, rgba(5, 5, 10, 0.96) 100%);
  }

  .game-item {
    min-height: 108px;
  }
}

</style>
</head>
<body>
<div class="wrap">
  <nav class="fade-in">
    <a href="#about">index</a>
    <a href="#favorite">favorite</a>
    <a href="#games">games</a>
    <a href="#anime">anime</a>
    <a href="#socials">links</a>
  </nav>

  <section class="section fade-in" id="about">
    <div class="name-stage" aria-label="todouro">
      <div class="name-fallback">
        <span>todouro</span>
        <span>todouro</span>
        <span>todouro</span>
        <span>todouro</span>
        <span>todouro</span>
      </div>
      <css-doodle class="name-doodle" id="nameDoodle"></css-doodle>
    </div>

    <div class="intro-meta">
      <p>gamer &amp; photographer</p>
      <p>16 years old · he/him</p>
      <p>bahrain 🇧🇭</p>
    </div>

    <p class="intro-bio">
      I like games, anime, photography, and making a quiet corner of the internet for the things I enjoy.
      Usually playing something, taking photos, or finding another series to add to the list.
    </p>

    <div class="profile-tags" aria-label="Interests">
      <span class="profile-tag">🎮 gaming</span>
      <span class="profile-tag">📷 photography</span>
      <span class="profile-tag">♟ chess</span>
      <span class="profile-tag">🌙 ep lover</span>
    </div>
  </section>

  <section class="section fade-in" id="favorite">
    <p class="sec-label">Favourite game</p>

    <a class="favorite-card" href="https://en.wikipedia.org/wiki/The_Legend_of_Zelda:_Breath_of_the_Wild" target="_blank" rel="noopener noreferrer">
      <span class="favorite-copy">
        <span class="favorite-kicker">all-time favourite</span>
        <strong class="favorite-title">The Legend of Zelda:<br>Breath of the Wild</strong>
        <span class="favorite-quote">“Best game I've ever played.”</span>
      </span>
    </a>
  </section>

  <section class="section fade-in" id="games">
    <p class="sec-label">Games I like</p>

    <div class="games-grid">
      <div class="game-item">
        <img class="game-cover" src="assets/games/zelda-botw.jpg" alt="The Legend of Zelda: Breath of the Wild">
        <div class="game-info"><div class="game-name">Zelda: Breath of the Wild</div><div class="game-sub">favourite · adventure</div></div>
      </div>

      <div class="game-item">
        <img class="game-cover" src="assets/games/elden-ring.jpg" alt="Elden Ring">
        <div class="game-info"><div class="game-name">Elden Ring</div><div class="game-sub">action RPG</div></div>
      </div>

      <div class="game-item">
        <img class="game-cover" src="assets/games/muse-dash.jpg" alt="Muse Dash">
        <div class="game-info"><div class="game-name">Muse Dash</div><div class="game-sub">rhythm game</div></div>
      </div>

      <div class="game-item">
        <img class="game-cover" src="assets/games/among-us.jpg" alt="Among Us">
        <div class="game-info"><div class="game-name">Among Us</div><div class="game-sub">social deduction</div></div>
      </div>

      <div class="game-item">
        <img class="game-cover" src="assets/games/mecha-domination.jpg" alt="Mecha Domination">
        <div class="game-info"><div class="game-name">Mecha Domination</div><div class="game-sub">strategy</div></div>
      </div>

      <div class="game-item">
        <img class="game-cover" src="assets/games/assetto-corsa.jpg" alt="Assetto Corsa">
        <div class="game-info"><div class="game-name">Assetto Corsa</div><div class="game-sub">racing simulator</div></div>
      </div>

      <div class="game-item">
        <img class="game-cover" src="assets/games/peak.jpg" alt="PEAK">
        <div class="game-info"><div class="game-name">PEAK</div><div class="game-sub">co-op climbing</div></div>
      </div>

      <div class="game-item">
        <img class="game-cover" src="assets/games/efootball.jpg" alt="eFootball">
        <div class="game-info"><div class="game-name">eFootball</div><div class="game-sub">football</div></div>
      </div>
    </div>
  </section>

  <section class="section fade-in" id="anime">
    <p class="sec-label">Top anime picks</p>

    <div class="anime-list" id="anime-list">
      <a class="anime-item" data-anilist-searches="Attack on Titan|Shingeki no Kyojin" href="https://anilist.co/search/anime?search=Attack%20on%20Titan" target="_blank" rel="noopener noreferrer">
        <span class="anime-rank">01</span>
        <div class="anime-thumb"><div class="anime-thumb-fallback">AOT</div></div>
        <div class="anime-info">
          <div class="anime-title">Attack on Titan</div>
          <div class="anime-title-jp">進撃の巨人</div>
          <div class="anime-badge">top pick</div>
        </div>
      </a>

      <a class="anime-item" data-anilist-searches="VINLAND SAGA|Vinland Saga" href="https://anilist.co/search/anime?search=Vinland%20Saga" target="_blank" rel="noopener noreferrer">
        <span class="anime-rank">02</span>
        <div class="anime-thumb"><div class="anime-thumb-fallback">VS</div></div>
        <div class="anime-info">
          <div class="anime-title">Vinland Saga</div>
          <div class="anime-title-jp">ヴィンランド・サガ</div>
          <div class="anime-badge">top pick</div>
        </div>
      </a>

      <a class="anime-item" data-anilist-searches="Frieren: Beyond Journey's End|Sousou no Frieren" href="https://anilist.co/search/anime?search=Frieren" target="_blank" rel="noopener noreferrer">
        <span class="anime-rank">03</span>
        <div class="anime-thumb"><div class="anime-thumb-fallback">FR</div></div>
        <div class="anime-info">
          <div class="anime-title">Frieren: Beyond Journey's End</div>
          <div class="anime-title-jp">葬送のフリーレン</div>
          <div class="anime-badge">top pick</div>
        </div>
      </a>

      <a class="anime-item" data-anilist-searches="DEATH NOTE|Death Note" href="https://anilist.co/search/anime?search=Death%20Note" target="_blank" rel="noopener noreferrer">
        <span class="anime-rank">04</span>
        <div class="anime-thumb"><div class="anime-thumb-fallback">DN</div></div>
        <div class="anime-info">
          <div class="anime-title">Death Note</div>
          <div class="anime-title-jp">デスノート</div>
          <div class="anime-badge">top pick</div>
        </div>
      </a>

      <a class="anime-item" data-anilist-searches="Blue Box|Ao no Hako" href="https://anilist.co/search/anime?search=Blue%20Box" target="_blank" rel="noopener noreferrer">
        <span class="anime-rank">05</span>
        <div class="anime-thumb"><div class="anime-thumb-fallback">BB</div></div>
        <div class="anime-info">
          <div class="anime-title">Blue Box</div>
          <div class="anime-title-jp">アオのハコ</div>
          <div class="anime-badge">top pick</div>
        </div>
      </a>
    </div>
  </section>

  <section class="section fade-in" id="socials">
    <p class="sec-label">Connections</p>

    <div class="connection-list">
      <span class="connection-pill">Epic · todouro.</span>
      <a class="connection-pill" href="https://github.com/todouro" target="_blank" rel="noopener noreferrer">GitHub · todouro ↗</a>
      <a class="connection-pill" href="https://www.roblox.com/search/users?keyword=Fenrix_YouthYT" target="_blank" rel="noopener noreferrer">Roblox · Fenrix_YouthYT ↗</a>
      <a class="connection-pill" href="https://steamcommunity.com/search/users/#text=todouro" target="_blank" rel="noopener noreferrer">Steam · todouro ↗</a>
      <a class="connection-pill" href="https://todouro.github.io/" target="_blank" rel="noopener noreferrer">Website · todouro.github.io ↗</a>
    </div>

    <p class="link-note">Discord display: todouro · Member since 13 May 2023</p>
  </section>

  <footer class="fade-in">
    <p>© 2026 todouro</p>
  </footer>
</div>

<script>
(function () {
  const doodleCss = `
:doodle {
  overflow: visible;
}

@grid: 5x1 / 100% 100% / transparent;
@content: todouro;
@place: center;
@size: 100% 0;
color: @pn(#f8fafc, #c4b5fd, #a78bfa, #818cf8, #475569);
z-index: @I(-@i);
font-family: "JetBrains Mono", monospace;
font-weight: bold;
font-size: clamp(42px, 11vw, 96px);
line-height: 0;
text-stroke: .25vw #05050a;
-webkit-text-stroke: .25vw #05050a;
transition: @i(*.05s);
scale: calc(1 - .05 * @i);
rotate: calc(8deg/@uw*(@ux - @uw/2) * @dx(-2));
translate: 0 calc(2vh/@uh*(@uy - @uh/2) * @dx(-2));
`;

  const nameDoodle = document.getElementById("nameDoodle");

  function loadDoodle() {
    if (!nameDoodle) return;
    nameDoodle.innerHTML = "<style>" + doodleCss + "</style>";
    if (typeof nameDoodle.update === "function") nameDoodle.update();
  }

  if (window.customElements && customElements.whenDefined) {
    customElements.whenDefined("css-doodle").then(loadDoodle).catch(loadDoodle);
  } else {
    setTimeout(loadDoodle, 100);
  }

  const links = Array.from(document.querySelectorAll('nav a[href^="#"]'));
  const sections = links
    .map(function (link) { return document.querySelector(link.getAttribute("href")); })
    .filter(Boolean);

  function moveTo(y, ms) {
    const start = window.scrollY || window.pageYOffset;
    const change = y - start;
    const startTime = performance.now();

    function step(now) {
      const progress = Math.min((now - startTime) / ms, 1);
      const smooth = 1 - Math.pow(1 - progress, 3);
      window.scrollTo(0, start + change * smooth);
      if (progress < 1) requestAnimationFrame(step);
    }

    requestAnimationFrame(step);
  }

  links.forEach(function (link) {
    link.addEventListener("click", function (event) {
      const target = document.querySelector(link.getAttribute("href"));
      if (!target) return;

      event.preventDefault();
      const gap = window.innerWidth <= 640 ? 88 : 108;
      const y = Math.max(0, target.getBoundingClientRect().top + window.scrollY - gap);
      moveTo(y, 650);
      history.replaceState(null, "", link.getAttribute("href"));
    });
  });

  function updateNav() {
    let current = sections[0];

    sections.forEach(function (section) {
      if (section.getBoundingClientRect().top <= 150) current = section;
    });

    links.forEach(function (link) {
      link.classList.toggle("is-active", link.getAttribute("href") === "#" + current.id);
    });
  }

  async function queryAnilist(search) {
    const query = `
query ($search: String) {
  Media(search: $search, type: ANIME) {
    siteUrl
    bannerImage
    coverImage {
      extraLarge
      large
      medium
      color
    }
    title {
      romaji
      english
      native
    }
  }
}`;

    const result = await fetch("https://graphql.anilist.co", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "Accept": "application/json"
      },
      body: JSON.stringify({ query: query, variables: { search: search } })
    });

    if (!result.ok) throw new Error("AniList request failed");
    const json = await result.json();
    return json && json.data ? json.data.Media : null;
  }

  async function getAnilistMedia(searches) {
    for (const search of searches) {
      try {
        const media = await queryAnilist(search);
        if (media) return media;
      } catch (error) {}
    }
    return null;
  }

  function cleanCssUrl(value) {
    return String(value || "").replace(/["\\\n\r]/g, "");
  }

  function applyAnimeMedia(card, media) {
    if (!card || !media) return;

    const cover = media.coverImage && (media.coverImage.extraLarge || media.coverImage.large || media.coverImage.medium);
    const banner = media.bannerImage || cover;
    const accent = media.coverImage && media.coverImage.color;
    const image = card.querySelector(".anime-logo");
    const fallback = card.querySelector(".anime-thumb-fallback");
    const nativeTitle = card.querySelector(".anime-title-jp");

    if (banner) card.style.setProperty("--anime-banner", `url("${cleanCssUrl(banner)}")`);
    if (accent) card.style.setProperty("--anime-accent", accent);

    if (cover) {
      if (image) {
        image.src = cover;
      } else if (fallback) {
        fallback.outerHTML = `<img class="anime-logo" src="${cleanCssUrl(cover)}" alt="anime cover">`;
      }
    }

    if (nativeTitle && media.title && media.title.native) nativeTitle.textContent = media.title.native;
    if (media.siteUrl) card.href = media.siteUrl;
  }

  async function loadAnimeCards() {
    const cards = Array.from(document.querySelectorAll(".anime-item[data-anilist-searches]"));

    await Promise.all(cards.map(async function (card) {
      const searches = card.getAttribute("data-anilist-searches")
        .split("|")
        .map(function (item) { return item.trim(); })
        .filter(Boolean);

      const media = await getAnilistMedia(searches);
      applyAnimeMedia(card, media);
    }));
  }

  updateNav();
  loadAnimeCards();
  window.addEventListener("scroll", updateNav, { passive: true });
})();
</script>
</body>
</html>
