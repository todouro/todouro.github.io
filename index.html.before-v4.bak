<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#000000">
<meta name="description" content="Todouro's personal site — games, anime, photography and links.">
<title>todouro</title>

<link rel="preconnect" href="https://fonts.bunny.net">
<link rel="preconnect" href="https://graphql.anilist.co">
<link rel="preconnect" href="https://shared.fastly.steamstatic.com">
<link rel="preconnect" href="https://cdn.cloudflare.steamstatic.com">
<link rel="preconnect" href="https://upload.wikimedia.org">
<link rel="preconnect" href="https://play-lh.googleusercontent.com">
<link rel="preconnect" href="https://cdn.simpleicons.org">
<link href="https://fonts.bunny.net/css?family=jetbrains-mono:400,500,600,700,800|outfit:400,500,600,700,800" rel="stylesheet">

<style>
*, *::before, *::after { box-sizing: border-box; }
html { scroll-behavior: smooth; scroll-padding-top: 104px; }
:root {
  --bg: #000000;
  --surface: #030303;
  --surface-2: #080808;
  --surface-3: #0d0d0d;
  --border: rgba(255,255,255,.085);
  --border-strong: rgba(255,255,255,.16);
  --text: #f1f3f8;
  --muted: #a0a8b8;
  --faint: #687287;
  --violet: #a78bfa;
  --blue: #8da2fb;
  --green: #55d98b;
  --mono: "JetBrains Mono", monospace;
  --body: "Outfit", sans-serif;
  --spring: cubic-bezier(.16,1,.3,1);
}

body {
  margin: 0;
  min-height: 100vh;
  overflow-x: hidden;
  background: #000;
  color: var(--text);
  font-family: var(--mono);
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  font-synthesis: none;
}

.site-background {
  position: fixed;
  inset: 0;
  z-index: -20;
  overflow: hidden;
  pointer-events: none;
  background: #000;
}

.site-anime-layer {
  position: absolute;
  inset: -48px;
  opacity: 0;
  background-repeat: no-repeat;
  background-size: cover;
  background-position: center;
  filter: blur(34px) saturate(1.08) brightness(.52);
  transform: scale(1.08);
  transition: opacity .48s ease;
  will-change: opacity;
}

.site-anime-layer.is-active {
  opacity: .46;
}

.site-background-shade {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle at 50% 32%, rgba(0,0,0,.08), rgba(0,0,0,.58) 58%, rgba(0,0,0,.92) 100%),
    linear-gradient(180deg, rgba(0,0,0,.22), rgba(0,0,0,.72) 62%, #000 100%);
}

.site-background-noise {
  position: absolute;
  inset: 0;
  opacity: .018;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.82' numOctaves='2' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.42'/%3E%3C/svg%3E");
}

.profile-banner {
  position: absolute;
  top: 0;
  left: 50%;
  z-index: -10;
  width: min(100vw, 1720px);
  height: clamp(280px, 35vw, 520px);
  overflow: hidden;
  pointer-events: none;
  transform: translateX(-50%);
  opacity: .34;
  -webkit-mask-image: linear-gradient(to bottom, #000 0%, rgba(0,0,0,.92) 46%, transparent 100%);
  mask-image: linear-gradient(to bottom, #000 0%, rgba(0,0,0,.92) 46%, transparent 100%);
}

.profile-banner::before {
  content: "";
  position: absolute;
  inset: -26px;
  background-color: #050505;
  background-image:
    linear-gradient(90deg, rgba(0,0,0,.5), transparent 24%, transparent 76%, rgba(0,0,0,.5)),
    url("https://cdn.discordapp.com/banners/1379090219688525898/a_3b166365fd9e870c9de281e935f4d94b.gif?size=1024&animated=true");
  background-repeat: no-repeat;
  background-size: cover;
  background-position: center 34%;
  filter: blur(8px) saturate(.92) brightness(.72);
  transform: scale(1.04);
}

.profile-banner::after {
  content: "";
  position: absolute;
  inset: 0;
  background:
    linear-gradient(180deg, rgba(0,0,0,.12), rgba(0,0,0,.48) 62%, #000),
    radial-gradient(circle at center top, transparent, rgba(0,0,0,.35) 74%);
}


a { color: inherit; }
img { display: block; max-width: 100%; }
button, a { -webkit-tap-highlight-color: transparent; }

.wrap {
  position: relative;
  z-index: 1;
  width: min(100%, 980px);
  margin: 0 auto;
  padding: 38px 28px 90px;
}

.site-nav {
  position: sticky;
  top: 14px;
  z-index: 50;
  width: fit-content;
  max-width: calc(100vw - 28px);
  display: flex;
  justify-content: center;
  gap: 6px;
  margin: 0 auto 60px;
  padding: 7px;
  border: 1px solid rgba(255,255,255,.09);
  border-radius: 17px;
  background: rgba(2,2,2,.86);
  box-shadow: 0 14px 40px rgba(0,0,0,.28);
  backdrop-filter: blur(18px) saturate(1.08);
}

.site-nav a {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 35px;
  padding: 8px 12px 10px;
  border-radius: 11px;
  color: var(--faint);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: .14em;
  text-decoration: none;
  text-transform: uppercase;
  white-space: nowrap;
  transition: color .18s ease, background .18s ease, box-shadow .18s ease, transform .18s var(--spring);
}

.site-nav a::after {
  content: "";
  position: absolute;
  left: 12px;
  right: 12px;
  bottom: 5px;
  height: 2px;
  border-radius: 999px;
  background: linear-gradient(90deg, var(--violet), #d8c7ff);
  opacity: 0;
  transform: scaleX(.4);
  transition: opacity .18s ease, transform .18s var(--spring);
}

.site-nav a:hover,
.site-nav a.is-active {
  color: var(--text);
  background: rgba(255,255,255,.052);
}

.site-nav a.is-active { box-shadow: inset 0 0 0 1px rgba(255,255,255,.045); }
.site-nav a.is-active::after { opacity: 1; transform: scaleX(1); }
.site-nav a:active { transform: translateY(1px); }

.section { position: relative; margin-bottom: 68px; }
.section-label {
  display: flex;
  align-items: center;
  gap: 13px;
  margin: 0 0 20px;
  color: var(--faint);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: .2em;
  text-transform: uppercase;
}
.section-label::after {
  content: "";
  flex: 1;
  height: 1px;
  background: linear-gradient(90deg, rgba(255,255,255,.13), transparent);
}

.hero { padding-top: 6px; }
.wordmark {
  position: relative;
  width: fit-content;
  margin: 0 0 22px;
  color: #fbfbff;
  font-size: clamp(52px, 10vw, 98px);
  font-weight: 800;
  line-height: .92;
  letter-spacing: -.075em;
  text-shadow:
    0 5px 0 #c4b5fd,
    0 10px 0 #8da2fb,
    0 15px 0 #5b617f;
}

.hero-meta { display: grid; gap: 7px; margin-bottom: 22px; }
.hero-meta p { margin: 0; color: var(--muted); font-size: 13px; }
.hero-meta p::before { content: "-> "; color: var(--faint); }
.hero-copy {
  max-width: 680px;
  margin: 0;
  color: #d7dbe5;
  font-family: var(--body);
  font-size: 16px;
  line-height: 1.72;
}
.tags, .connections { display: flex; flex-wrap: wrap; gap: 9px; }
.tags { margin-top: 22px; }
.tag, .connection {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  min-height: 36px;
  padding: 8px 12px;
  border: 1px solid var(--border);
  border-radius: 999px;
  background: rgba(14,14,22,.88);
  color: var(--muted);
  font-size: 11px;
  text-decoration: none;
  transition: color .18s ease, border-color .18s ease, background .18s ease, transform .18s var(--spring);
}
.tag:hover, .connection:hover {
  color: var(--text);
  border-color: var(--border-strong);
  background: rgba(255,255,255,.048);
  transform: translateY(-1px);
}
.connection img { width: 17px; height: 17px; object-fit: contain; }

.favorite-card {
  --cover: url("https://upload.wikimedia.org/wikipedia/en/0/0d/Legend_of_Zelda_Breath_of_the_Wild_box_art.jpg");
  position: relative;
  isolation: isolate;
  min-height: 290px;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
  padding: 28px;
  border: 1px solid rgba(141,162,251,.23);
  border-radius: 24px;
  background: var(--surface);
  color: inherit;
  text-decoration: none;
  box-shadow: 0 20px 54px rgba(0,0,0,.24);
  transition: transform .22s var(--spring), border-color .18s ease, box-shadow .18s ease;
}
.favorite-card::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -2;
  background-image: var(--cover), url("assets/games/zelda-botw.jpg");
  background-size: cover;
  background-position: center 35%;
  transform: scale(1.012);
  transition: transform .4s var(--spring);
}
.favorite-card::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -1;
  background:
    linear-gradient(90deg, rgba(5,5,8,.97) 0%, rgba(5,5,8,.79) 48%, rgba(5,5,8,.22) 100%),
    linear-gradient(180deg, rgba(5,5,8,.08), rgba(5,5,8,.86));
}
.favorite-card:hover {
  transform: translateY(-2px);
  border-color: rgba(167,139,250,.46);
  box-shadow: 0 26px 70px rgba(0,0,0,.34), 0 0 30px rgba(141,162,251,.08);
}
.favorite-card:hover::before { transform: scale(1.045); }
.favorite-copy { max-width: 540px; }
.favorite-kicker {
  display: block;
  margin-bottom: 10px;
  color: #c4b5fd;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: .2em;
  text-transform: uppercase;
}
.favorite-title {
  display: block;
  color: #fff;
  font-family: var(--body);
  font-size: clamp(27px, 5vw, 46px);
  line-height: 1.02;
  letter-spacing: -.04em;
}
.favorite-quote {
  display: block;
  margin-top: 13px;
  color: rgba(241,243,248,.8);
  font-family: var(--body);
  font-size: 15px;
}

.games-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
}
.game-card {
  position: relative;
  min-height: 178px;
  overflow: hidden;
  border: 1px solid var(--border);
  border-radius: 21px;
  background: var(--surface);
  color: inherit;
  text-decoration: none;
  box-shadow: 0 14px 40px rgba(0,0,0,.18);
  transition: transform .22s var(--spring), border-color .18s ease, box-shadow .18s ease;
}
.game-card:hover {
  transform: translateY(-2px);
  border-color: rgba(255,255,255,.17);
  box-shadow: 0 20px 55px rgba(0,0,0,.29);
}
.game-cover {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 36%;
  opacity: .92;
  transform: scale(1.01);
  transition: transform .38s var(--spring), opacity .25s ease;
}
.game-card:hover .game-cover { transform: scale(1.045); opacity: 1; }
.game-card::after {
  content: "";
  position: absolute;
  inset: 0;
  background:
    linear-gradient(90deg, rgba(5,5,8,.94) 0%, rgba(5,5,8,.62) 56%, rgba(5,5,8,.18) 100%),
    linear-gradient(180deg, rgba(5,5,8,.05) 25%, rgba(5,5,8,.88) 100%);
}
.game-content {
  position: relative;
  z-index: 2;
  min-height: 178px;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: flex-end;
  padding: 20px;
}
.game-logo {
  width: min(72%, 230px);
  max-height: 54px;
  margin-bottom: 10px;
  object-fit: contain;
  object-position: left bottom;
  filter: drop-shadow(0 4px 14px rgba(0,0,0,.6));
}
.game-logo.is-missing { display: none; }
.game-title {
  margin: 0;
  color: #fff;
  font-family: var(--body);
  font-size: 19px;
  font-weight: 800;
  line-height: 1.08;
  text-shadow: 0 3px 18px rgba(0,0,0,.7);
}
.game-logo:not(.is-missing) + .game-title { font-size: 12px; color: rgba(255,255,255,.72); }
.game-meta {
  margin-top: 5px;
  color: rgba(241,243,248,.66);
  font-size: 10px;
  letter-spacing: .06em;
}

.anime-section { isolation: isolate; }
.anime-ambient { display: none; }
.anime-list { display: grid; gap: 14px; }
.anime-card {
  --anime-banner: none;
  --anime-accent: #a78bfa;
  position: relative;
  isolation: isolate;
  min-height: 150px;
  display: flex;
  align-items: center;
  gap: 18px;
  overflow: hidden;
  padding: 17px;
  border: 1px solid var(--border);
  border-radius: 21px;
  background: rgba(2,2,2,.91);
  color: inherit;
  text-decoration: none;
  box-shadow: 0 14px 38px rgba(0,0,0,.17);
  transition: transform .22s var(--spring), border-color .18s ease, box-shadow .18s ease, background .18s ease;
}
.anime-card::before {
  content: "";
  position: absolute;
  inset: -18px;
  z-index: -2;
  background-image: var(--anime-banner);
  background-size: cover;
  background-position: center;
  filter: blur(16px) saturate(1.15);
  opacity: 0;
  transform: scale(1.12);
  transition: opacity .28s ease, transform .38s var(--spring);
}
.anime-card::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -1;
  background:
    linear-gradient(90deg, rgba(0,0,0,.96) 0%, rgba(0,0,0,.82) 46%, rgba(0,0,0,.5) 100%),
    linear-gradient(180deg, rgba(0,0,0,.12), rgba(0,0,0,.84));
}
.anime-card:hover,
.anime-card:focus-visible {
  transform: translateY(-2px);
  border-color: color-mix(in srgb, var(--anime-accent) 48%, rgba(255,255,255,.16));
  box-shadow: 0 20px 56px rgba(0,0,0,.31), 0 0 26px color-mix(in srgb, var(--anime-accent) 10%, transparent);
}
.anime-card:hover::before,
.anime-card:focus-visible::before { opacity: .7; transform: scale(1.16); }
.anime-rank {
  flex: 0 0 38px;
  color: rgba(241,243,248,.23);
  font-size: 14px;
  font-weight: 800;
  letter-spacing: .08em;
  text-align: center;
}
.anime-cover-wrap {
  width: 82px;
  height: 116px;
  flex: 0 0 auto;
  overflow: hidden;
  border: 1px solid rgba(255,255,255,.12);
  border-radius: 14px;
  background: rgba(255,255,255,.04);
  box-shadow: 0 13px 34px rgba(0,0,0,.34);
}
.anime-cover { width: 100%; height: 100%; object-fit: cover; }
.anime-fallback {
  width: 100%; height: 100%;
  display: grid; place-items: center;
  padding: 10px;
  background: linear-gradient(145deg, rgba(167,139,250,.22), rgba(141,162,251,.12));
  color: #fff;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: .1em;
  text-align: center;
}
.anime-copy { min-width: 0; }
.anime-title {
  color: #fff;
  font-family: var(--body);
  font-size: 19px;
  font-weight: 800;
  line-height: 1.12;
  text-shadow: 0 3px 18px rgba(0,0,0,.6);
}
.anime-native { margin-top: 6px; color: rgba(241,243,248,.63); font-size: 11px; }
.anime-badge {
  display: inline-flex;
  align-items: center;
  margin-top: 11px;
  padding: 5px 9px;
  border: 1px solid color-mix(in srgb, var(--anime-accent) 38%, rgba(255,255,255,.1));
  border-radius: 999px;
  background: color-mix(in srgb, var(--anime-accent) 14%, rgba(8,8,13,.78));
  color: #d9d0ff;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: .12em;
  text-transform: uppercase;
}

.links-note { margin: 15px 0 0; color: var(--faint); font-size: 10px; line-height: 1.6; }
footer {
  margin-top: 48px;
  padding-top: 22px;
  border-top: 1px solid var(--border);
  color: var(--faint);
  font-size: 10px;
  letter-spacing: .08em;
}

.fade-in { opacity: 0; transform: translateY(10px); animation: fade-up .46s ease forwards; }
.fade-in:nth-child(1) { animation-delay: .03s; }
.fade-in:nth-child(2) { animation-delay: .09s; }
.fade-in:nth-child(3) { animation-delay: .15s; }
.fade-in:nth-child(4) { animation-delay: .21s; }
.fade-in:nth-child(5) { animation-delay: .27s; }
.fade-in:nth-child(6) { animation-delay: .33s; }
@keyframes fade-up { to { opacity: 1; transform: translateY(0); } }

:focus-visible { outline: 2px solid #c4b5fd; outline-offset: 4px; }

@media (max-width: 760px) {
  .wrap { padding: 28px 16px 70px; }
  .site-nav {
    top: 9px;
    width: auto;
    max-width: calc(100vw - 24px);
    margin-bottom: 46px;
    overflow-x: auto;
    justify-content: flex-start;
    scrollbar-width: none;
  }
  .site-nav::-webkit-scrollbar { display: none; }
  .site-nav a { flex: 0 0 auto; padding-inline: 10px; font-size: 10px; }
  .section { margin-bottom: 54px; }
  .wordmark { font-size: clamp(50px, 16vw, 78px); text-shadow: 0 4px 0 #c4b5fd, 0 8px 0 #8da2fb, 0 12px 0 #5b617f; }
  .favorite-card { min-height: 330px; padding: 22px; }
  .favorite-card::after {
    background: linear-gradient(180deg, rgba(5,5,8,.1) 8%, rgba(5,5,8,.72) 60%, rgba(5,5,8,.96) 100%);
  }
  .games-grid { grid-template-columns: 1fr; }
  .game-card, .game-content { min-height: 190px; }
  .anime-card { min-height: 236px; flex-direction: column; justify-content: center; text-align: center; padding: 22px 18px; }
  .anime-card::after { background: linear-gradient(180deg, rgba(5,5,8,.42), rgba(5,5,8,.92)); }
  .anime-rank { position: absolute; top: 14px; left: 14px; }
  .anime-cover-wrap { width: 94px; height: 132px; }
  .anime-badge { margin-inline: auto; }
  .anime-ambient { inset: 25px -18px -20px; }
}

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
}
</style>
</head>
<body>
<div class="site-background" aria-hidden="true">
  <div class="site-anime-layer" id="siteAnimeLayerA"></div>
  <div class="site-anime-layer" id="siteAnimeLayerB"></div>
  <div class="site-background-shade"></div>
  <div class="site-background-noise"></div>
</div>
<div class="profile-banner" aria-hidden="true"></div>
<div class="wrap">
  <nav class="site-nav fade-in" aria-label="Primary navigation">
    <a href="#about">index</a>
    <a href="#favorite">favorite</a>
    <a href="#games">games</a>
    <a href="#anime">anime</a>
    <a href="#links">links</a>
  </nav>

  <main>
    <section class="section hero fade-in" id="about">
      <h1 class="wordmark">todouro</h1>
      <div class="hero-meta">
        <p>gamer &amp; photographer</p>
        <p>16 years old · he/him</p>
        <p>bahrain 🇧🇭</p>
      </div>
      <p class="hero-copy">
        I like games, anime, photography and chess. This is my small corner of the internet for the things I enjoy most.
      </p>
      <div class="tags" aria-label="Interests">
        <span class="tag">🎮 gaming</span>
        <span class="tag">📷 photography</span>
        <span class="tag">♟ chess</span>
        <span class="tag">🌙 ep lover</span>
      </div>
    </section>

    <section class="section fade-in" id="favorite">
      <p class="section-label">Favourite game</p>
      <a class="favorite-card" href="https://www.nintendo.com/us/store/products/the-legend-of-zelda-breath-of-the-wild-switch/" target="_blank" rel="noopener noreferrer">
        <span class="favorite-copy">
          <span class="favorite-kicker">all-time favourite</span>
          <strong class="favorite-title">The Legend of Zelda:<br>Breath of the Wild</strong>
          <span class="favorite-quote">“Best game I've ever played.”</span>
        </span>
      </a>
    </section>

    <section class="section fade-in" id="games">
      <p class="section-label">Games I like</p>
      <div class="games-grid">

        <a class="game-card" href="https://www.nintendo.com/us/store/products/the-legend-of-zelda-breath-of-the-wild-switch/" target="_blank" rel="noopener noreferrer">
          <img class="game-cover" src="https://upload.wikimedia.org/wikipedia/en/0/0d/Legend_of_Zelda_Breath_of_the_Wild_box_art.jpg" data-fallbacks='["assets/games/zelda-botw.jpg"]' alt="The Legend of Zelda: Breath of the Wild cover" loading="eager" decoding="async">
          <div class="game-content">
            <img class="game-logo" src="https://upload.wikimedia.org/wikipedia/commons/thumb/6/6f/The_Legend_of_Zelda_Breath_of_the_Wild.svg/512px-The_Legend_of_Zelda_Breath_of_the_Wild.svg.png" data-fallbacks='[]' alt="The Legend of Zelda: Breath of the Wild logo" decoding="async">
            <h2 class="game-title">The Legend of Zelda: Breath of the Wild</h2>
            <span class="game-meta">favourite · adventure</span>
          </div>
        </a>

        <a class="game-card" href="https://store.steampowered.com/app/1245620/ELDEN_RING/" target="_blank" rel="noopener noreferrer">
