    </section>

    <section class="section anime-section fade-in" id="anime">
      <div class="anime-ambient" aria-hidden="true"></div>
      <p class="section-label">Top anime picks</p>
      <div class="anime-list">
        <a class="anime-card" data-anilist="Attack on Titan|Shingeki no Kyojin" href="https://anilist.co/search/anime?search=Attack%20on%20Titan" target="_blank" rel="noopener noreferrer">
          <span class="anime-rank">01</span><div class="anime-cover-wrap"><div class="anime-fallback">AOT</div></div>
          <div class="anime-copy"><div class="anime-title">Attack on Titan</div><div class="anime-native">進撃の巨人</div><span class="anime-badge">top pick</span></div>
        </a>
        <a class="anime-card" data-anilist="Vinland Saga|VINLAND SAGA" href="https://anilist.co/search/anime?search=Vinland%20Saga" target="_blank" rel="noopener noreferrer">
          <span class="anime-rank">02</span><div class="anime-cover-wrap"><div class="anime-fallback">VS</div></div>
          <div class="anime-copy"><div class="anime-title">Vinland Saga</div><div class="anime-native">ヴィンランド・サガ</div><span class="anime-badge">top pick</span></div>
        </a>
        <a class="anime-card" data-anilist="Frieren: Beyond Journey's End|Sousou no Frieren" href="https://anilist.co/search/anime?search=Frieren" target="_blank" rel="noopener noreferrer">
          <span class="anime-rank">03</span><div class="anime-cover-wrap"><div class="anime-fallback">FR</div></div>
          <div class="anime-copy"><div class="anime-title">Frieren: Beyond Journey's End</div><div class="anime-native">葬送のフリーレン</div><span class="anime-badge">top pick</span></div>
        </a>
        <a class="anime-card" data-anilist="Death Note|DEATH NOTE" href="https://anilist.co/search/anime?search=Death%20Note" target="_blank" rel="noopener noreferrer">
          <span class="anime-rank">04</span><div class="anime-cover-wrap"><div class="anime-fallback">DN</div></div>
          <div class="anime-copy"><div class="anime-title">Death Note</div><div class="anime-native">デスノート</div><span class="anime-badge">top pick</span></div>
        </a>
        <a class="anime-card" data-anilist="Blue Box|Ao no Hako" href="https://anilist.co/search/anime?search=Blue%20Box" target="_blank" rel="noopener noreferrer">
          <span class="anime-rank">05</span><div class="anime-cover-wrap"><div class="anime-fallback">BB</div></div>
          <div class="anime-copy"><div class="anime-title">Blue Box</div><div class="anime-native">アオのハコ</div><span class="anime-badge">top pick</span></div>
        </a>
      </div>
    </section>

    <section class="section fade-in" id="links">
      <p class="section-label">Connections</p>
      <div class="connections">
        <span class="connection"><img src="https://cdn.simpleicons.org/epicgames/FFFFFF" alt="" loading="lazy">todouro.</span>
        <a class="connection" href="https://github.com/todouro" target="_blank" rel="noopener noreferrer"><img src="https://cdn.simpleicons.org/github/FFFFFF" alt="" loading="lazy">todouro ↗</a>
        <a class="connection" href="https://www.roblox.com/search/users?keyword=Fenrix_YouthYT" target="_blank" rel="noopener noreferrer"><img src="https://cdn.simpleicons.org/roblox/FFFFFF" alt="" loading="lazy">Fenrix_YouthYT ↗</a>
        <a class="connection" href="https://steamcommunity.com/search/users/#text=todouro" target="_blank" rel="noopener noreferrer"><img src="https://cdn.simpleicons.org/steam/FFFFFF" alt="" loading="lazy">todouro ↗</a>
        <a class="connection" href="https://todouro.github.io/" target="_blank" rel="noopener noreferrer"><img src="https://cdn.simpleicons.org/githubpages/FFFFFF" alt="" loading="lazy">todouro.github.io ↗</a>
      </div>
      <p class="links-note">Discord display: todouro · Member since 13 May 2023</p>
    </section>
  </main>

  <footer class="fade-in">© 2026 todouro</footer>
</div>

<script>
(function () {
  "use strict";

  function installImageFallback(img) {
    let fallbacks = [];
    try { fallbacks = JSON.parse(img.dataset.fallbacks || "[]"); } catch (_) {}
    let index = 0;

    function next() {
      if (index < fallbacks.length) {
        img.src = fallbacks[index++];
        return;
      }
      if (img.classList.contains("game-logo")) img.classList.add("is-missing");
    }

    img.addEventListener("error", next);
    if (img.complete && img.naturalWidth === 0) next();
  }

  document.querySelectorAll("img[data-fallbacks]").forEach(installImageFallback);

  const links = Array.from(document.querySelectorAll('.site-nav a[href^="#"]'));
  const sections = links.map(link => document.querySelector(link.getAttribute("href"))).filter(Boolean);

  function updateNav() {
    let current = sections[0];
    for (const section of sections) {
      if (section.getBoundingClientRect().top <= 145) current = section;
    }
    links.forEach(link => link.classList.toggle("is-active", link.getAttribute("href") === "#" + current.id));
  }

  links.forEach(link => {
    link.addEventListener("click", event => {
      const target = document.querySelector(link.getAttribute("href"));
      if (!target) return;
      event.preventDefault();
      const gap = window.innerWidth <= 760 ? 82 : 102;
      const top = Math.max(0, target.getBoundingClientRect().top + window.scrollY - gap);
      window.scrollTo({ top, behavior: "smooth" });
      history.replaceState(null, "", link.getAttribute("href"));
    });
  });

  const animeSection = document.querySelector(".anime-section");
  const animeCards = Array.from(document.querySelectorAll(".anime-card[data-anilist]"));
  const animeLayers = [
    document.getElementById("siteAnimeLayerA"),
    document.getElementById("siteAnimeLayerB")
  ].filter(Boolean);
  let activeAnimeLayer = -1;
  let activeAnimeBanner = "";
  const CACHE_PREFIX = "todouro:anilist:v2:";
  const CACHE_TTL = 7 * 24 * 60 * 60 * 1000;

  function cleanUrl(value) { return String(value || "").replace(/["\\\n\r]/g, ""); }

  async function queryAniList(search) {
    const key = CACHE_PREFIX + search.toLowerCase();
    try {
      const cached = JSON.parse(localStorage.getItem(key) || "null");
      if (cached && Date.now() - cached.savedAt < CACHE_TTL) return cached.media;
    } catch (_) {}

    const query = `query ($search: String) {
      Media(search: $search, type: ANIME) {
        siteUrl bannerImage
        coverImage { extraLarge large medium color }
        title { romaji english native }
      }
    }`;

    const response = await fetch("https://graphql.anilist.co", {
      method: "POST",
      headers: { "Content-Type": "application/json", "Accept": "application/json" },
      body: JSON.stringify({ query, variables: { search } })
    });
    if (!response.ok) throw new Error("AniList request failed");
    const body = await response.json();
    const media = body && body.data ? body.data.Media : null;
    if (media) {
      try { localStorage.setItem(key, JSON.stringify({ savedAt: Date.now(), media })); } catch (_) {}
    }
    return media;
  }

  async function findAnime(searches) {
    for (const search of searches) {
      try {
        const media = await queryAniList(search);
        if (media) return media;
      } catch (_) {}
    }
    return null;
  }

  function setSiteAnimeBackground(card) {
    const banner = card && card.dataset ? card.dataset.banner : "";
    if (!banner || !animeLayers.length || banner === activeAnimeBanner) return;

    const nextIndex = activeAnimeLayer === 0 ? 1 : 0;
    const nextLayer = animeLayers[nextIndex];
    const previousLayer = activeAnimeLayer >= 0 ? animeLayers[activeAnimeLayer] : null;

    nextLayer.style.backgroundImage = `url("${cleanUrl(banner)}")`;
    nextLayer.classList.add("is-active");

    if (previousLayer && previousLayer !== nextLayer) {
      previousLayer.classList.remove("is-active");
    }

    activeAnimeLayer = nextIndex;
    activeAnimeBanner = banner;
  }

  function clearSiteAnimeBackground() {
    animeLayers.forEach(layer => layer.classList.remove("is-active"));
    activeAnimeLayer = -1;
    activeAnimeBanner = "";
  }

  function applyAnime(card, media) {
    if (!media) return;
    const cover = media.coverImage && (media.coverImage.extraLarge || media.coverImage.large || media.coverImage.medium);
    const banner = media.bannerImage || cover;
    const accent = media.coverImage && media.coverImage.color;
    const coverWrap = card.querySelector(".anime-cover-wrap");
    const native = card.querySelector(".anime-native");

    if (banner) {
      const safe = cleanUrl(banner);
      card.style.setProperty("--anime-banner", `url("${safe}")`);
      card.dataset.banner = safe;
    }
    if (accent) card.style.setProperty("--anime-accent", accent);
    if (cover && coverWrap) coverWrap.innerHTML = `<img class="anime-cover" src="${cleanUrl(cover)}" alt="Anime cover" loading="lazy" decoding="async">`;
    if (native && media.title && media.title.native) native.textContent = media.title.native;
    if (media.siteUrl) card.href = media.siteUrl;
  }

  animeCards.forEach(card => {
    card.addEventListener("mouseenter", () => setSiteAnimeBackground(card));
    card.addEventListener("focus", () => setSiteAnimeBackground(card));
  });

  if (animeSection) {
    animeSection.addEventListener("mouseleave", clearSiteAnimeBackground);
    animeSection.addEventListener("focusout", event => {
      if (!animeSection.contains(event.relatedTarget)) clearSiteAnimeBackground();
    });
  }

  Promise.all(animeCards.map(async card => {
    const searches = card.dataset.anilist.split("|").map(v => v.trim()).filter(Boolean);
    const media = await findAnime(searches);
    applyAnime(card, media);
  })).catch(() => {});

  updateNav();
  window.addEventListener("scroll", updateNav, { passive: true });
})();
</script>
</body>
</html>
